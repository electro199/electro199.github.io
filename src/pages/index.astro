---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogCard from '../components/BlogCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Aman Raza</h1>
				<p class="tagline">Full-stack Developer</p>
				<p class="bio">
					I build full stack applications with Python and Django, backed by PostgreSQL. My
					focus areas are media processing pipelines (FFmpeg, MoviePy, OpenCV) and integerating in SaaS applications focusing
					real life use cases. 
				</p>
			</section>

			<section id="projects">
				<h2>Projects</h2>
				<div class="grid">
					{projects.map((project) => <ProjectCard project={project} />)}
				</div>
			</section>

			<section class="skills">
				<h2>Skills</h2>
				<ul class="tag-list">
					<li>Python</li>
					<li>Django</li>
					<li>PostgreSQL</li>
					<li>FFmpeg</li>
					<li>MoviePy</li>
					<li>OpenCV</li>
					<li>OpenAI</li>
					<li>LaTeX</li>
				</ul>
			</section>
			
			{
				latestPosts.length > 0 && (
					<section id="blog">
						<h2>Latest writing</h2>
						<div class="grid">
							{latestPosts.map((post) => (
								<BlogCard post={post} />
							))}
						</div>
						<a class="view-all" href="/blog">
							View all posts →
						</a>
					</section>
				)
			}
			
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		padding: 2em 0;
	}
	.hero {
		padding-top: 1em;
	}
	.tagline {
		font-size: 1.3em;
		font-weight: 600;
		color: var(--accent);
	}
	.bio {
		max-width: 60ch;
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tag-list li {
		padding: 0.3em 0.9em;
		border-radius: 999px;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.9em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.5em;
	}
	.view-all {
		display: inline-block;
		margin-top: 1em;
		font-weight: 600;
	}
</style>
