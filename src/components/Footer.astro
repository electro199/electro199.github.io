---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Aman Raza. All rights reserved.
	<ul class="social-links">
		<li><a href="https://github.com/electro199" target="_blank" rel="noopener noreferrer">GitHub</a></li>
		<li><a href="mailto:your-email@example.com">Email</a></li>
		<li>
			<a href="https://linkedin.com/in/your-profile" target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</li>
		<li><a href="https://x.com/your-handle" target="_blank" rel="noopener noreferrer">X</a></li>
	</ul>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: var(--bg-elevated);
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		list-style: none;
		margin-top: 1em;
		padding: 0;
	}
	.social-links a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.social-links a:hover {
		color: var(--accent);
	}
</style>
